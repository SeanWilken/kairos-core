{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myai.dev/schemas/interop/v0.2/onboarding-runtime-status.schema.json",
  "title": "OnboardingRuntimeStatus",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec_version", "session_id", "checks", "summary", "observed_at"],
  "properties": {
    "spec_version": { "type": "string", "const": "v0.2" },
    "session_id": { "type": "string", "minLength": 1 },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "label", "required", "status"],
        "properties": {
          "check_id": {
            "type": "string",
            "enum": [
              "core_health_endpoint",
              "postgres_reachable",
              "postgres_auth_valid",
              "postgres_database_exists",
              "pgvector_extension",
              "pgvector_version_compatible",
              "migration_permissions",
              "provider_connectivity",
              "local_model_endpoint",
              "vector_provider_connectivity"
            ]
          },
          "label": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" },
          "status": { "type": "string", "enum": ["pass", "warn", "fail", "pending"] },
          "reason_code": { "type": "string" },
          "message": { "type": "string" },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "endpoint": { "type": "string" },
              "http_status": { "type": "integer", "minimum": 100, "maximum": 599 },
              "latency_ms": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_passed", "required_failed", "required_pending"],
      "properties": {
        "required_passed": { "type": "integer", "minimum": 0 },
        "required_failed": { "type": "integer", "minimum": 0 },
        "required_pending": { "type": "integer", "minimum": 0 }
      }
    },
    "observed_at": { "type": "string", "format": "date-time" }
  }
}

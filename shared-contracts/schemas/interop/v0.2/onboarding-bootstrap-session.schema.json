{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myai.dev/schemas/interop/v0.2/onboarding-bootstrap-session.schema.json",
  "title": "OnboardingBootstrapSession",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec_version",
    "session_id",
    "tenant_id",
    "org_id",
    "status",
    "runtime",
    "database",
    "deployment",
    "secrets",
    "vector",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "spec_version": { "type": "string", "const": "v0.2" },
    "session_id": { "type": "string", "minLength": 1 },
    "tenant_id": { "type": "string", "minLength": 1 },
    "org_id": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["draft", "preflight_passed", "artifacts_generated", "runtime_verified", "completed", "failed"]
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenant_name", "tenant_type", "model_modes", "connections"],
      "properties": {
        "tenant_name": { "type": "string", "minLength": 1 },
        "tenant_type": { "type": "string", "enum": ["company", "individual"] },
        "model_modes": {
          "type": "array",
          "items": { "type": "string", "enum": ["api_provider", "local_model"] },
          "minItems": 1,
          "uniqueItems": true
        },
        "connections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "mode", "provider", "endpoint", "model_ref", "priority"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "mode": { "type": "string", "enum": ["api_provider", "local_model"] },
              "provider": { "type": "string", "minLength": 1 },
              "endpoint": { "type": "string", "format": "uri" },
              "model_ref": { "type": "string", "minLength": 1 },
              "priority": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connection_mode",
        "deployment_location",
        "host",
        "port",
        "database_name",
        "username",
        "requires_pgvector",
        "password_ref"
      ],
      "properties": {
        "connection_mode": { "type": "string", "enum": ["existing", "new"] },
        "deployment_location": { "type": "string", "enum": ["local", "remote"] },
        "host": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "database_name": { "type": "string", "minLength": 1 },
        "username": { "type": "string", "minLength": 1 },
        "ssl_mode": {
          "type": "string",
          "enum": ["disable", "prefer", "require", "verify-ca", "verify-full"],
          "default": "prefer"
        },
        "requires_pgvector": { "type": "boolean" },
        "password_ref": {
          "type": "string",
          "description": "Reference key only; raw password is never persisted in server-side contracts."
        }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "execution_mode", "infra_components"],
      "properties": {
        "target": { "type": "string", "enum": ["docker_local", "github_actions", "k8s", "terraform"] },
        "execution_mode": { "type": "string", "enum": ["generate_only", "attempt_automated"] },
        "infra_components": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "storage_target", "required_key_names"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["template_only", "transient_validate_only", "pipeline_injected"]
        },
        "storage_target": { "type": "string", "minLength": 1 },
        "required_key_names": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "vector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "provider", "namespace_pattern", "index_strategy"],
      "properties": {
        "mode": { "type": "string", "enum": ["disabled", "enabled"] },
        "provider": { "type": "string", "enum": ["pgvector", "pinecone"] },
        "namespace_pattern": { "type": "string" },
        "index_strategy": { "type": "string", "enum": ["flat", "hnsw", "ivfflat"] },
        "endpoint": { "type": "string" }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}

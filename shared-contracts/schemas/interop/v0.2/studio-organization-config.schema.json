{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myai.dev/schemas/interop/v0.2/studio-organization-config.schema.json",
  "title": "StudioOrganizationConfig",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec_version", "org_id", "name", "divisions", "members", "created_at", "updated_at"],
  "properties": {
    "spec_version": { "type": "string", "const": "v0.2" },
    "org_id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "divisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["division_id", "name"],
        "properties": {
          "division_id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" }
        }
      }
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["user_id", "email", "role"],
        "properties": {
          "user_id": { "type": "string", "minLength": 1 },
          "email": { "type": "string", "format": "email" },
          "role": { "type": "string", "enum": ["global_admin", "org_admin", "division_admin", "member"] },
          "division_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}

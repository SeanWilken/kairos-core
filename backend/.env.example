APP_NAME=kairos-core-backend
APP_ENV=local
APP_PORT=8000
SINGLE_TENANT_MODE=true
INSTALL_TENANT_ID=tenant-local
JWT_SECRET=change-me

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aitg
POSTGRES_USER=aitg
POSTGRES_PASSWORD=aitg_local_password
KAIROS_DATABASE_URL=postgresql+psycopg://aitg:aitg_local_password@localhost:5432/aitg

# AI providers
LLM_PROVIDER=openai
LLM_LIVE_MODE=false
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_MODELS=gpt-4o-mini,gpt-4.1-mini
OPENAI_IMAGE_MODELS=gpt-image-1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FAST_MODEL=gemini-2.5-flash
GEMINI_BALANCED_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=imagen-3.0-generate-002
GEMINI_VIDEO_MODEL=veo-2.0-generate-001
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-pro
GEMINI_IMAGE_MODELS=imagen-3.0-generate-002
GEMINI_VIDEO_MODELS=veo-2.0-generate-001

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MODELS=claude-sonnet-4-20250514

# Capability routing
TOOL_PROVIDER_CHAT=openai
TOOL_PROVIDER_IMAGE_GENERATION=google
TOOL_PROVIDER_VIDEO_GENERATION=google
TOOL_PROVIDER_EMAIL_SEND=email

# External service adapters
EMAIL_SERVICE_PROVIDER=

# Image tool endpoints (optional overrides)
OPENAI_IMAGE_ENDPOINT=https://api.openai.com/v1/images/generations

# Email providers
# TOOL_PROVIDER_EMAIL_SEND can be: email, smtp, sendgrid
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_USE_TLS=true
SENDGRID_API_KEY=
